# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Secrets (secret_key, tokens, credentials) must come from the environment
# or a secret store — never hard-coded and never logged.

ENVIRONMENT=dev
DEBUG=false
SECRET_KEY=change-me-in-a-real-environment-0123456789

# PostgreSQL (psycopg 3 driver). Production target: PostgreSQL 18.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_assistant
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis + Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Observability
LOG_LEVEL=INFO

# AI provider (Phase 4; OpenRouter per owner decision 2026-09-15).
#   template           -> offline, deterministic (default, no keys needed)
#   openai_compatible  -> any OpenAI-compatible /chat/completions endpoint
#   openrouter         -> OpenRouter gateway (key: sk-or-...)
AI_PROVIDER=template
AI_REQUEST_TIMEOUT_SECONDS=30
# openai_compatible:
# AI_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_OPENAI_API_KEY=
# AI_OPENAI_MODEL=gpt-4o-mini
# openrouter (model slugs are vendor/model, e.g. openai/gpt-4o-mini,
# anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001):
# AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_OPENROUTER_API_KEY=
# AI_OPENROUTER_MODEL=openai/gpt-4o-mini

# Telegram (Phase 5) — the SHARED organization bot (one per platform,
# not per business). Empty = publication disabled until configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT_SECONDS=30
