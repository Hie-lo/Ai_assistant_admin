# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Secrets (secret_key, tokens, credentials) must come from the environment
# or a secret store — never hard-coded and never logged.

ENVIRONMENT=dev
DEBUG=false
SECRET_KEY=change-me-in-a-real-environment-0123456789

# PostgreSQL (psycopg 3 driver). Production target: PostgreSQL 18.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_assistant
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis + Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Observability
LOG_LEVEL=INFO
